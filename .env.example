# Copy to .env; provide your own values. Never commit .env.
MOA_INTERNAL_TOKEN=
MOA_ALLOWED_TENANTS=syncnote
MOA_GEMINI_API_KEY=
# Choose a model available to your Google AI Studio account.
MOA_GEMINI_MODEL=gemini-3.5-flash-lite
MOA_GEMINI_TIMEOUT_MS=30000
MOA_BACKEND_BASE_URL=http://localhost:8000
MOA_BACKEND_SERVICE_TOKEN=
# Separate credential per service/tenant when enabling additional tenants.

MOA_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
MOA_EMBEDDING_DIMENSIONS=768
MOA_CHROMA_PATH=.data/chroma
MOA_RAG_ENABLED=true
MOA_ENABLE_PREVIEW=false
