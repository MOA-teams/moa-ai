# Copy to .env only when creating a new environment. Never commit real credentials.
MOA_INTERNAL_TOKEN=
MOA_ALLOWED_TENANTS=syncnote

# Generation provider: bedrock | gemini | auto (may call both providers).
MOA_LLM_PROVIDER=bedrock
MOA_AWS_REGION=ap-northeast-1
MOA_BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
MOA_BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
MOA_BEDROCK_MAX_TOKENS=2048
# Optional bearer key. EC2 IAM Role / standard AWS SDK credentials are also supported.
MOA_BEDROCK_API_KEY=
# Optional development relay when local AWS credentials are absent; leave blank on EC2.
MOA_BEDROCK_SSH_HOST=
MOA_BEDROCK_SSH_USER=ubuntu
MOA_BEDROCK_SSH_KEY_PATH=

# Optional when MOA_LLM_PROVIDER=bedrock (Bedrock embeddings are used automatically).
MOA_GEMINI_API_KEY=
MOA_GEMINI_MODEL=gemini-3.5-flash-lite
# Empty: use only the model above. Set an explicit list only if fallback is needed.
MOA_GEMINI_FALLBACK_MODELS=
MOA_GEMINI_MAX_RETRIES=2
MOA_GEMINI_TIMEOUT_MS=30000
MOA_ANALYSIS_MAX_INPUT_CHARS=30000
MOA_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
MOA_EMBEDDING_DIMENSIONS=768

MOA_CHROMA_PATH=.data/chroma
MOA_RAG_ENABLED=true
MOA_RAG_MIN_SCORE=0.5
MOA_ENABLE_PREVIEW=false

MOA_BACKEND_BASE_URL=http://localhost:8000
MOA_BACKEND_SERVICE_TOKEN=
